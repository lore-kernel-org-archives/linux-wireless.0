 	} else {
 		PRINTM(MEVENT, "hs_deactived\n");
 		priv->adapter->hs_activated = false;
-		mwifiex_recv_event(priv, MWIFIEX_EVENT_ID_DRV_HS_DEACTIVATED,
-				   NULL);
 	}
 
 	LEAVE();
@@ -1313,11 +1277,11 @@ mwifiex_host_sleep_wakeup_event(struct mwifiex_private *priv)
