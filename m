      brcmf_err(bus, "gtk_key_info iovar failed: ret=%d\n", ret);
                ^
   drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c:32:16: note: in definition of macro 'brcmf_err'
