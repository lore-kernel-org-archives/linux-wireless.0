 net/mac80211/hwflags.c         | 68 +++---------------------------------------
 net/mac80211/hwflags.h         | 47 +++++------------------------
 5 files changed, 52 insertions(+), 180 deletions(-)
 create mode 100644 include/net/mac80211-hwflags.h

