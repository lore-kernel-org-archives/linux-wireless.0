index 0d0e060..01b238a 100644
--- a/drivers/net/wireless/ath5k/base.c
+++ b/drivers/net/wireless/ath5k/base.c
@@ -95,7 +95,7 @@ enum {
 	ATH_LED_RX,
 };
 
-static int ath5k_calinterval = 1; /* Calibrate PHY every 1 sec (TODO: Fixme) */
