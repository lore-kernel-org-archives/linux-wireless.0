    94		/* if this is a wireless device, then ask its throughput through
    95		 * cfg80211 API
    96		 */
    97		if (batadv_is_wifi_hardif(hard_iface)) {
    98			if (!batadv_is_cfg80211_hardif(hard_iface))
    99				/* unsupported WiFi driver version */
